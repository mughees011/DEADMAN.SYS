# ─── LLM Provider ──────────────────────────────────────────────────────────────
# litellm routes to any provider based on LLM_MODEL.
# Set the model name AND the matching provider key below.
# Default: claude-sonnet-4-6 (Anthropic). Change both if switching providers.
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# If switching to OpenAI:
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# If switching to Gemini:
# LLM_MODEL=gemini/gemini-2.5-pro
# GEMINI_API_KEY=your_gemini_api_key_here

# ─── Alpaca (Broker) ────────────────────────────────────────────────────────────
APCA_API_KEY_ID=your_alpaca_api_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here
# APCA_PAPER=true  → paper trading (safe, default). Set false only after full paper audit.
APCA_PAPER=true

# ─── Survival Constants ─────────────────────────────────────────────────────────
SPAWN_THRESHOLD=500.00
SPAWN_SEED=100.00
TAX_RATE=0.150
# Cycle interval in minutes (60 = hourly for testing; 1440 = daily for production)
CYCLE_INTERVAL_MINUTES=60

# ─── Dashboard Auth ─────────────────────────────────────────────────────────────
DASHBOARD_USER=boss
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
DASHBOARD_PASS_HASH=pbkdf2:sha256:replace_this_with_real_hash